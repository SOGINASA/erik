# Python — байткод-кэш и артефакты генерируются при каждом запуске, в git не нужны
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Виртуальные окружения
/backend/venv/
/backend/venv_back/
/backend/.venv/
/backend/env/

# Окружение
/backend/.env

# База данных
/backend/database/*.db
/backend/database/*.sqlite

# OS
.DS_Store
Thumbs.db

/backend/PLAN.md
/backend/PLAN2.md

# ML — окружение и сгенерированные данные в git не нужны;
# артефакты модели (ml/artifacts/*) КОММИТИМ — бэкенду нужен обученный
# .joblib в проде, без переобучения на сервере.
/ml/.venv/
/ml/__pycache__/
/ml/*.py[cod]
/ml/data/